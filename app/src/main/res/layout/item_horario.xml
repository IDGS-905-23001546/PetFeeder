<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_white_card"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Fila superior: ícono + nombre + toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/ivHorarioIconBg"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_icon_circle_cream">

            <ImageView
                android:id="@+id/ivHorarioIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_sun"
                android:tint="#C68A00"
                android:contentDescription="@null" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHorarioNombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Desayuno"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHorarioInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7:30 AM · 100g"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchHorarioActivo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:trackTint="@color/switch_track_tint"
            app:thumbTint="@color/switch_thumb_tint" />

    </LinearLayout>

    <!-- Fila de días (poblada programáticamente) -->
    <LinearLayout
        android:id="@+id/diasRowHorario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal" />

    <!-- Botón eliminar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:layout_marginTop="10dp">

        <ImageView
            android:id="@+id/btnDeleteHorario"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_trash"
            android:tint="#E74C3C"
            android:contentDescription="Eliminar horario"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
