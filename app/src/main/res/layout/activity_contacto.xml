<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="28dp">

        <!-- Volver -->
        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_white_card_circle"
            android:elevation="2dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/text_primary"
                android:contentDescription="Volver" />
        </FrameLayout>

        <!-- Encabezado -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="SOPORTE"
            android:textColor="@color/blue_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Contáctanos"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:text="¿Tienes dudas, sugerencias o encontraste un problema? Escríbenos y te responderemos a la brevedad."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- ===== Tarjeta: Correo ===== -->
        <LinearLayout
            android:id="@+id/cardCorreo"
            style="@style/ContactoCard">
            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_icon_circle_blue">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_email"
                    android:tint="@color/blue_primary"
                    android:contentDescription="@null" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView style="@style/ContactoCardTitle" android:text="Correo electrónico" />
                <TextView style="@style/ContactoCardSub" android:text="Respuesta en menos de 24 horas" />
                <TextView style="@style/ContactoCardLink" android:text="carlosriosrmz17@gmail.com" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Tarjeta: GitHub ===== -->
        <LinearLayout
            android:id="@+id/cardGithub"
            style="@style/ContactoCard">
            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_icon_circle_blue">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_github"
                    android:tint="@color/blue_primary"
                    android:contentDescription="@null" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView style="@style/ContactoCardTitle" android:text="GitHub" />
                <TextView style="@style/ContactoCardSub" android:text="Reporta bugs o contribuye al proyecto" />
                <TextView style="@style/ContactoCardLink" android:text="github.com/pawfeeder" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Tarjeta: Manual ===== -->
        <LinearLayout
            android:id="@+id/cardManual"
            style="@style/ContactoCard">
            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_icon_circle_blue">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_book"
                    android:tint="@color/blue_primary"
                    android:contentDescription="@null" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView style="@style/ContactoCardTitle" android:text="Manual de uso" />
                <TextView style="@style/ContactoCardSub" android:text="Antes de escribirnos, revisa la documentación" />
                <TextView style="@style/ContactoCardLink" android:text="Ver manual" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Formulario ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="12dp"
            android:text="Envíanos un mensaje"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView style="@style/ContactoLabel" android:text="Nombre" />
        <LinearLayout style="@style/ContactoInputBox">
            <EditText
                android:id="@+id/etNombre"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="Tu nombre"
                android:inputType="textCapWords"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView style="@style/ContactoLabel" android:text="Correo electrónico" />
        <LinearLayout style="@style/ContactoInputBox">
            <EditText
                android:id="@+id/etCorreo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="tu@correo.com"
                android:inputType="textEmailAddress"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView style="@style/ContactoLabel" android:text="Asunto" />
        <LinearLayout style="@style/ContactoInputBox">
            <Spinner
                android:id="@+id/spinnerAsunto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null" />
        </LinearLayout>

        <TextView style="@style/ContactoLabel" android:text="Mensaje" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_field"
            android:padding="12dp">
            <EditText
                android:id="@+id/etMensaje"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="@null"
                android:gravity="top"
                android:hint="Describe tu consulta con el mayor detalle posible…"
                android:inputType="textMultiLine|textCapSentences"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnEnviar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:backgroundTint="@color/blue_primary"
            android:text="Enviar mensaje"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
